# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — no installation required)
DATABASE_URL="file:./dev.db"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Change this before going to production!
LEAP360_API_KEY=leap360-dev-secret-key-change-me

# The UUID of the project seeded by `pnpm seed`
SEED_PROJECT_ID=00000000-0000-0000-0000-000000000001

# Dashboard login credentials
ADMIN_EMAIL=admin@leap360.ai
ADMIN_PASSWORD=admin123

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
