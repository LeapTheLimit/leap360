{
    "name": "api",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate": "prisma migrate dev --name init",
        "migrate:deploy": "prisma migrate deploy",
        "seed": "ts-node src/seed.ts",
        "seed:built": "node dist/seed.js",
        "generate": "prisma generate"
    },
    "dependencies": {
        "@fastify/cors": "^9.0.1",
        "@prisma/client": "^5.10.2",
        "dotenv": "^16.4.5",
        "fastify": "^4.26.2",
        "pino-pretty": "^13.0.0",
        "uuid": "^9.0.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.11.25",
        "@types/uuid": "^9.0.8",
        "prisma": "^5.10.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    }
}
