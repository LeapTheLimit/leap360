{
  "name": "leap360-sdk",
  "version": "1.0.0",
  "description": "Leap360 AI Governance SDK — monitor, trace, and govern your AI agents in real-time",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "leap360": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/make-executable.js",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "node dist/cli.js --version",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --prefix api",
    "dev:web": "npm run dev --prefix web",
    "migrate": "npm run migrate --prefix api",
    "seed": "npm run seed --prefix api",
    "generate": "npm run generate --prefix api"
  },
  "keywords": [
    "ai",
    "governance",
    "monitoring",
    "tracing",
    "llm",
    "agents",
    "observability",
    "openai",
    "gemini",
    "leap360"
  ],
  "author": "Leap360",
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^12.0.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
